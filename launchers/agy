#!/bin/sh
# Move agy into its WireGuard-routed cgroup, then replace this wrapper.
set -eu

user_name=$(id -un)
app_cgroup=/sys/fs/cgroup/wg-app-route/agy-$user_name
ready_file=/run/wg-app-route/wg0.ready
real_command=/absolute/path/to/agy

if [ "$(id -u)" -eq 0 ]; then
	printf '%s\n' 'agy: run this launcher as your regular user.' >&2
	exit 1
fi
if [ ! -r "$ready_file" ]; then
	printf '%s\n' 'agy: start wg0 before launching the app.' >&2
	exit 1
fi
if [ ! -e "$app_cgroup/cgroup.procs" ]; then
	printf '%s\n' 'agy: cgroup is unavailable; restart wg0 as root.' >&2
	exit 1
fi
if [ ! -x "$real_command" ]; then
	printf '%s\n' "agy: edit real_command in this launcher (not executable: $real_command)." >&2
	exit 1
fi

if ! pkexec --disable-internal-agent /usr/local/libexec/wg-app-route/move-pid agy "$$"; then
	printf '%s\n' 'agy: polkit authorization for the cgroup move is not configured.' >&2
	exit 1
fi
exec "$real_command" "$@"
